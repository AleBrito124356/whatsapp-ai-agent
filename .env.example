# ---------------------------------------------------------------------------
# WhatsApp AI Agent — environment configuration
# Copy to .env and fill in. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- Meta WhatsApp Cloud API ------------------------------------------------
# System User or temporary access token for your WhatsApp Business app.
# Meta App Dashboard -> WhatsApp -> API Setup -> Temporary access token,
# or generate a permanent System User token in Business Settings.
WHATSAPP_TOKEN=EAAG_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The Phone Number ID (NOT the phone number itself).
# Meta App Dashboard -> WhatsApp -> API Setup -> "Phone number ID".
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# A random string YOU choose. You type the same value into the Meta webhook
# config; Meta echoes it back on the GET verification handshake.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# Your App Secret, used to verify the X-Hub-Signature-256 on every webhook.
# Meta App Dashboard -> App Settings -> Basic -> "App secret" (click Show).
WHATSAPP_APP_SECRET=00000000000000000000000000000000

# Graph API version to call. v21.0 is a safe recent default.
GRAPH_API_VERSION=v21.0

# Dry-run: while the token / phone number id above are empty or still these
# placeholders, nothing is sent to Meta. Replies are stored in a local outbox
# (GET /dev/outbox) and scripts/send_webhook.py prints them. Set to 1 to force
# dry-run even with real credentials (e.g. on a staging server).
# WHATSAPP_DRY_RUN=1

# --- NVIDIA NIM (LLM) -------------------------------------------------------
# Free API key from https://build.nvidia.com (takes ~2 minutes).
# Starts with "nvapi-". Leave the placeholder to run in offline mode
# (keyword routing + raw KB answers, no generation).
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Override the model or endpoint if you like.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Business profile -------------------------------------------------------
BUSINESS_NAME=Barbería Studio Norte
# One line the LLM uses to describe you ("You are the WhatsApp assistant for
# <BUSINESS_NAME>, <BUSINESS_DESCRIPTION>").
BUSINESS_DESCRIPTION=a barbershop in Panama City
BUSINESS_PHONE=+507 6000-0000
# Drives which days/hours can be booked (see WEEKLY_HOURS in app/catalog.py).
BUSINESS_TIMEZONE=America/Panama

# --- Staff console (/admin) ---------------------------------------------------
# Bearer token for the human-handoff API. Empty = /admin answers 503.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Optional: local voice-note transcription (faster-whisper) --------------
# Model size: tiny | base | small | medium | large-v3. "base" is a good balance.
WHISPER_MODEL=base

# --- Optional: override the SQLite path -------------------------------------
# DB_PATH=data/bookings.sqlite
